{
  "schemaVersion": 1,
  "id": "v2dit_camera_logger",
  "version": "${version}",
  "name": "V2DiT Camera Logger",
  "description": "Exports per-frame Minecraft camera poses for V2DiT experiments.",
  "authors": ["V2DiT project"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "io.v2dit.camera.V2DitCameraLoggerClient"
    ]
  },
  "mixins": [
    "v2dit-camera-logger.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.0",
    "minecraft": "26.1.2",
    "java": ">=25",
    "fabric-api": ">=0.155.0",
    "flashback": ">=0.43.3"
  }
}

